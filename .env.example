# Required for real Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional X recent-search access
TWITTER_BEARER_TOKEN=
TWITTER_QUERIES='(hackathon OR buildathon) ("apply now" OR registration OR open) -is:retweet lang:en||("web3 hackathon" OR "blockchain hackathon") (open OR register) -is:retweet lang:en||("AI hackathon" OR "ML hackathon") (open OR apply) -is:retweet lang:en'

# Runtime
DATABASE_PATH=seen_hackathons.db
POLL_INTERVAL_MINUTES=20
BOOTSTRAP_MODE=baseline
DEBUG_MODE=false
HTTP_TIMEOUT_SECONDS=15
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_SECONDS=5

# Source toggles
ENABLE_DEVPOST=true
ENABLE_DEVFOLIO=true
ENABLE_DORAHACKS=true
ENABLE_MLH=true
ENABLE_LABLAB=true
ENABLE_HACKEREARTH=true
ENABLE_GITCOIN=true
ENABLE_TWITTER=true

# Optional source tuning
DEVPOST_MAX_PAGES=2
DORAHACKS_MAX_PAGES=2
# MLH_SEASONS=2026,2027
