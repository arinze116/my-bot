[Unit]
Description=Hackathon Radar Telegram Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/my-bot
EnvironmentFile=/home/ubuntu/my-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/my-bot/.venv/bin/python main.py
Restart=always
RestartSec=10
UMask=0077
SyslogIdentifier=hackathon-radar

[Install]
WantedBy=multi-user.target
